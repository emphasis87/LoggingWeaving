<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LoggingWeavingBuildHostPath>$([System.IO.Path]::GetFullPath('$([System.IO.Path]::Combine($(MSBuildProjectDirectory), '..', '..', 'src', 'LoggingWeaving.BuildHost', 'bin', $(Configuration), 'net8.0', 'LoggingWeaving.BuildHost.dll'))'))</LoggingWeavingBuildHostPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LoggingWeaving.Generator\LoggingWeaving.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\LoggingWeaving.BuildHost\LoggingWeaving.BuildHost.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Import Project="..\..\build\LoggingWeaving.props" />
  <Import Project="..\..\build\LoggingWeaving.targets" />

</Project>
